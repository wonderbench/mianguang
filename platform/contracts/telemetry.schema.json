{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mianguang:telemetry:1",
  "title": "Mianguang platform P0 telemetry v1",
  "description": "Design contract, not a claim of implemented network firmware. Validate UUID/date-time formats explicitly. Receipt freshness, credential binding, replay protection and deployment authorization are server rules in docs/device_protocol.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "binding_id",
    "boot_id",
    "seq",
    "captured_at",
    "uptime_ms",
    "firmware_version",
    "sample"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "binding_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "boot_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "firmware_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sample": {
      "$ref": "#/$defs/sample"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "available",
        "valid",
        "reason",
        "age_ms"
      ],
      "properties": {
        "raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "available": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "ok",
            "missing",
            "stale",
            "transport_fault",
            "installation_unconfirmed",
            "invalid_value",
            "out_of_range",
            "occupancy_unknown",
            "not_present",
            "not_in_bed",
            "motion_unknown",
            "motion",
            "conflicting_occupancy",
            "unknown"
          ]
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "available": {
                "const": true
              },
              "reason": {
                "const": "ok"
              },
              "age_ms": {
                "maximum": 5000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "not": {
                  "const": "ok"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "available": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "valid": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "occupancyField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "raw": {
              "maximum": 1
            }
          }
        }
      ]
    },
    "respirationField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "raw": {
                "minimum": 10,
                "maximum": 25
              }
            }
          }
        }
      ]
    },
    "heartField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "raw": {
                "minimum": 60,
                "maximum": 100
              }
            }
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radar_enabled",
        "ready",
        "installation_confirmed",
        "transport_ok",
        "presence",
        "bed",
        "rr",
        "hr",
        "low_motion",
        "lamp"
      ],
      "properties": {
        "radar_enabled": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "installation_confirmed": {
          "type": "boolean"
        },
        "transport_ok": {
          "type": "boolean"
        },
        "presence": {
          "$ref": "#/$defs/occupancyField"
        },
        "bed": {
          "$ref": "#/$defs/occupancyField"
        },
        "rr": {
          "$ref": "#/$defs/respirationField"
        },
        "hr": {
          "$ref": "#/$defs/heartField"
        },
        "low_motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw",
            "available",
            "valid"
          ],
          "properties": {
            "raw": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "available": {
              "type": "boolean"
            },
            "valid": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "valid": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "available": {
                    "const": true
                  }
                }
              }
            }
          ]
        },
        "lamp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "pwm",
            "target"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "manual"
              ]
            },
            "pwm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "target": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "presence": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "bed": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "radar_enabled": {
                "const": true
              },
              "ready": {
                "const": true
              },
              "installation_confirmed": {
                "const": true
              },
              "transport_ok": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "rr": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "hr": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "radar_enabled": {
                "const": true
              },
              "ready": {
                "const": true
              },
              "installation_confirmed": {
                "const": true
              },
              "transport_ok": {
                "const": true
              },
              "presence": {
                "properties": {
                  "raw": {
                    "const": 1
                  },
                  "available": {
                    "const": true
                  },
                  "valid": {
                    "const": true
                  }
                }
              },
              "bed": {
                "properties": {
                  "raw": {
                    "const": 1
                  },
                  "available": {
                    "const": true
                  },
                  "valid": {
                    "const": true
                  }
                }
              },
              "low_motion": {
                "properties": {
                  "raw": {
                    "const": 1
                  },
                  "available": {
                    "const": true
                  },
                  "valid": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
